<?xml version="1.0" encoding="utf-8"?>
<applicationTemplate type="module-building">
  <id>Intent.ApplicationTemplate.ModuleBuilderAiSkills</id>
  <version>1.0.0-pre.0</version>
  <supportedClientVersions>[3.0.0,5.0.0)</supportedClientVersions>
  <displayName>Intent Module Builder AI Skills</displayName>
  <coverImageUrl src="data:image/jpeg;base64," />
  <priority>0</priority>
  <icon type="UrlImagePath" source="data:image/svg+xml;base64," />
  <defaults>
    <name>NewApplication</name>
    <relativeOutputLocation />
    <placeInSameDirectory>false</placeInSameDirectory>
    <separateIntentFiles>true</separateIntentFiles>
    <setGitIgnoreEntries>true</setGitIgnoreEntries>
    <createFolderForSolution>true</createFolderForSolution>
  </defaults>
  <componentGroups>
    <group name="Agents">
      <selectionMode>allow-multiple</selectionMode>
      <components>
        <component id="402d607f-21d1-40eb-9e87-efbb0a5718e3" name="AI Skills" included="true" required="false">
          <icon type="UrlImagePath" source="data:image/svg+xml;base64," />
          <modules>
            <module id="Intent.ModuleBuilder.AI.Skills" version="1.0.0-pre.0">
              <includedByDefault>true</includedByDefault>
              <required>true</required>
            </module>
          </modules>
          <dependencies />
        </component>
      </components>
    </group>
    <group name="Developer Tooling">
      <selectionMode>allow-multiple</selectionMode>
      <components>
        <component id="93051302-074f-4b36-b599-36312a9f59fb" name="Codebase Structure" included="true" required="true">
          <icon type="UrlImagePath" source="data:image/svg+xml;base64," />
          <modules>
            <module id="Intent.Modelers.CodebaseStructure" version="1.0.2-pre.0">
              <includedByDefault>true</includedByDefault>
              <required>true</required>
            </module>
            <module id="Intent.Common.CSharp" version="3.10.10">
              <includedByDefault>true</includedByDefault>
              <required>true</required>
            </module>
          </modules>
          <dependencies />
        </component>
      </components>
    </group>
  </componentGroups>
  <additionalSettings>
    <group id="63303bb7-dbb2-4c41-b0dc-eb86065788d0" title="Basic Settings">
      <settings>
        <setting id="agents-folder" title="Agents Folder Name" type="select">
          <defaultValue>.agents</defaultValue>
          <isRequired>true</isRequired>
          <options>
            <option value=".agents" description=".agents" />
            <option value=".claude" description=".claude" />
            <option value=".codex" description=".codex" />
            <option value=".cursor" description=".cursor" />
            <option value=".gemini" description=".gemini" />
            <option value=".kiro" description=".kiro" />
          </options>
        </setting>
      </settings>
    </group>
  </additionalSettings>
</applicationTemplate>